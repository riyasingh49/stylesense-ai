
{
    "name": "stylesense-ai-server",
    "version": "1.0.0",
    "private": true,
    "description": "Backend API for the StyleSense AI lead generation and email marketing platform",
    "main": "dist/server.js",
    "scripts": {
      "dev": "tsx watch src/server.ts",
      "build": "tsc -p tsconfig.json",
      "start": "node dist/server.js",
      "typecheck": "tsc --noEmit -p tsconfig.json",
      "test": "vitest run",
      "test:watch": "vitest"
    },
    "engines": {
      "node": ">=20"
    },
    "dependencies": {
      "@supabase/supabase-js": "^2.57.0",
      "cors": "^2.8.5",
      "dotenv": "^16.6.1",
      "express": "^5.1.0",
      "groq-sdk": "^0.30.0",
      "helmet": "^8.1.0",
      "zod": "^4.1.5"
    },
    "devDependencies": {
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.3",
      "@types/node": "^22.18.0",
      "tsx": "^4.20.5",
      "typescript": "^5.9.2",
      "vitest": "^3.2.4"
    }
  }
  