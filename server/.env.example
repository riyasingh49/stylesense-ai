# Backend runtime
NODE_ENV=development
PORT=4000

# Frontend and backend URLs
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:4000

# Database: configure when Supabase is ready
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lead discovery provider
# mock = synthetic sample data
# gemini = optional AI-assisted discovery
DISCOVERY_PROVIDER=mock
GEMINI_API_KEY=

# Email provider
# mock = no real emails are sent
EMAIL_PROVIDER=mock
EMAIL_TEST_MODE=true

# Required for signed tracking and unsubscribe tokens
# Replace the placeholder in your local server/.env file
TRACKING_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
