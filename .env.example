# Shared application environment
NODE_ENV=development

# Server
PORT=4000

# Frontend URL
CLIENT_ORIGIN=http://localhost:5173

# Backend public base URL
APP_BASE_URL=http://localhost:4000

# Lead discovery: LangSearch
DISCOVERY_SEARCH_PROVIDER=langsearch
LANGSEARCH_API_KEY=

# Lead extraction: gemini or mock
LEAD_EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=

# Email provider: mock only; no real emails are sent
EMAIL_PROVIDER=mock
EMAIL_TEST_MODE=true

# Use a random secret of at least 32 characters
TRACKING_TOKEN_SECRET=
