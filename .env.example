
# Server configuration
NODE_ENV=development
PORT=4000

# Frontend origin (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Public application URL (tracking and unsubscribe links)
APP_BASE_URL=http://localhost:4000

# Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# AI lead discovery
# Supported modes: mock, gemini
DISCOVERY_PROVIDER=mock
GEMINI_API_KEY=

# Email provider
# Supported modes: mock, resend
EMAIL_PROVIDER=mock
EMAIL_TEST_MODE=true
RESEND_API_KEY=
EMAIL_FROM=

# Email tracking and unsubscribe token signing
TRACKING_TOKEN_SECRET=replace-with-a-long-random-secret
